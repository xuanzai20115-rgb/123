local function tween(object, duration, properties)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

local function minimizePanel()
    if minimized then return end
    minimized = true
    orb.Position = UDim2.new(
        panel.Position.X.Scale,
        panel.Position.X.Offset - 0,
        panel.Position.Y.Scale,
        panel.Position.Y.Offset + 0
    )
    orb.Visible = true
    orb.Size = UDim2.fromOffset(0, 0)
    tween(panel, 0.2, {
        Size = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1,
    }).Completed:Connect(function()
        panel.Visible = false
    end)
    tween(orb, 0.28, {Size = UDim2.fromOffset(52, 52)})
end

local function restorePanel()
    if not minimized then return end
    minimized = false
    panel.Position = UDim2.new(
        orb.Position.X.Scale,
        orb.Position.X.Offset,
        orb.Position.Y.Scale,
        orb.Position.Y.Offset
    )
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Size = UDim2.fromOffset(0, 0)
    panel.BackgroundTransparency = 1
    panel.Visible = true
    tween(orb, 0.16, {Size = UDim2.fromOffset(0, 0)}).Completed:Connect(function()
        orb.Visible = false
    end)
    tween(panel, 0.25, {
        Size = UDim2.fromOffset(244, 158),
        BackgroundTransparency = 0.08,
    })
end

