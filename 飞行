orb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragInput = input
        dragStart = input.Position
        dragOrigin = orb.Position
        orbPressPosition = input.Position
        orbMoved = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input == dragInput or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        if minimized then
            if delta.Magnitude > 7 then orbMoved = true end
            orb.Position = UDim2.new(
                dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
                dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y
            )
        else
            panel.Position = UDim2.new(
                dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
                dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y
            )
        end
    end
end)

orb.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if not orbMoved then
            restorePanel()
        end
        dragging = false
    end
end)

local function clearFlightEffects()
    if flightTrail then
        flightTrail:Destroy()
        flightTrail = nil
    end
    for _, item in ipairs(trailAttachments) do
        if item and item.Parent then item:Destroy() end
    end
    table.clear(trailAttachments)

    for motor, original in pairs(originalMotorTransforms) do
        if motor and motor.Parent then
            motor.Transform = original
        end
    end
    table.clear(originalMotorTransforms)
    table.clear(flightMotors)
end

local function createFlightEffects(character, root)
    clearFlightEffects()

    -- 两条蓝紫渐变光带，从角色背后延伸。
    local upper = Instance.new("Attachment")
    upper.Name = "YMR_Trail_Upper"
    upper.Position = Vector3.new(-0.42, 0.55, 0.72)
    upper.Parent = root

    local lower = Instance.new("Attachment")
    lower.Name = "YMR_Trail_Lower"
    lower.Position = Vector3.new(-0.42, -0.55, 0.72)
    lower.Parent = root

    table.insert(trailAttachments, upper)
    table.insert(trailAttachments, lower)

    flightTrail = Instance.new("Trail")
    flightTrail.Name = "YMR_AuroraTrail"
    flightTrail.Attachment0 = upper
    flightTrail.Attachment1 = lower
    flightTrail.FaceCamera = true
    flightTrail.Lifetime = 0.48
    flightTrail.MinLength = 0.08
    flightTrail.LightEmission = 0.85
    flightTrail.LightInfluence = 0
    flightTrail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.8),
        NumberSequenceKeypoint.new(0.45, 0.48),
        NumberSequenceKeypoint.new(1, 0),
    })
    flightTrail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.12),
        NumberSequenceKeypoint.new(1, 1),
    })
    flightTrail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(93, 222, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(105, 133, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(202, 112, 255)),
    })
    flightTrail.Parent = root
    flightTrail.Enabled = true

    -- 记录关节原始姿势，飞行时做轻微俯冲姿态，停止后还原。
    local wanted = {
        RightShoulder = true, LeftShoulder = true,
        RightHip = true, LeftHip = true,
        ["Right Shoulder"] = true, ["Left Shoulder"] = true,
        ["Right Hip"] = true, ["Left Hip"] = true,
        Waist = true,
    }
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Motor6D") and wanted[descendant.Name] then
            originalMotorTransforms[descendant] = descendant.Transform
            table.insert(flightMotors, descendant)
        end
    end
end

local function updateFlightPose(elapsed)
    local sway = math.sin(elapsed * 3.2) * 0.045
    for _, motor in ipairs(flightMotors) do
        if motor and motor.Parent then
            local name = motor.Name
            if name == "RightShoulder" or name == "Right Shoulder" then
                motor.Transform = CFrame.Angles(math.rad(-58), 0, math.rad(12) + sway)
            elseif name == "LeftShoulder" or name == "Left Shoulder" then
                motor.Transform = CFrame.Angles(math.rad(-58), 0, math.rad(-12) - sway)
            elseif name == "RightHip" or name == "Right Hip" then
                motor.Transform = CFrame.Angles(math.rad(13), 0, math.rad(5))
            elseif name == "LeftHip" or name == "Left Hip" then
                motor.Transform = CFrame.Angles(math.rad(13), 0, math.rad(-5))
            elseif name == "Waist" then
                motor.Transform = CFrame.Angles(math.rad(-9), 0, sway)
            end
        end
    end
end

local function enableLocalNoclip(character)
    table.clear(savedCollision)

    local function disableCollision(part)
        if part:IsA("BasePart") then
            if savedCollision[part] == nil then
                savedCollision[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        disableCollision(part)
    end

    if collisionAddedConnection then
        collisionAddedConnection:Disconnect()
    end
    collisionAddedConnection = character.DescendantAdded:Connect(function(part)
        if flying then
            disableCollision(part)
        end
    end)
end

local function restoreLocalCollision()
    if collisionAddedConnection then
        collisionAddedConnection:Disconnect()
        collisionAddedConnection = nil
    end

    for part, originalValue in pairs(savedCollision) do
        if part and part.Parent then
            part.CanCollide = originalValue
        end
    end
    table.clear(savedCollision)
end

local function protectFromFalling(root)
    if not root or not root.Parent then return end

    local rescueY = workspace.FallenPartsDestroyHeight + 100
    if root.Position.Y > rescueY then
        lastSafeCFrame = root.CFrame
    elseif lastSafeCFrame then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = lastSafeCFrame + Vector3.new(0, 12, 0)
    end
end

local function stopFlight()
    flying = false
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
    if linearVelocity then linearVelocity:Destroy(); linearVelocity = nil end
    if alignOrientation then alignOrientation:Destroy(); alignOrientation = nil end
    if attachment then attachment:Destroy(); attachment = nil end

    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = previousPlatformStand or false
        humanoid.AutoRotate = previousAutoRotate ~= nil and previousAutoRotate or true
    end
    humanoid = nil
    restoreLocalCollision()
    lastSafeCFrame = nil
    clearFlightEffects()

    status.Text = "●  飞行已关闭"
    status.TextColor3 = Color3.fromRGB(196, 210, 232)
    toggle.Text = "开启飞行"
    toggle.BackgroundColor3 = Color3.fromRGB(48, 126, 218)
end

local function startFlight()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local newHumanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not newHumanoid then
        status.Text = "●  角色尚未准备好"
        return
    end

    stopFlight()
    humanoid = newHumanoid
    lastSafeCFrame = root.CFrame
    enableLocalNoclip(character)
    previousPlatformStand = humanoid.PlatformStand
    previousAutoRotate = humanoid.AutoRotate

    -- 保留 Humanoid 默认控制器读取摇杆输入，不再提供自定义方向按钮
    humanoid.PlatformStand = false
    humanoid.AutoRotate = false

    attachment = Instance.new("Attachment")
    attachment.Parent = root

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = root

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Attachment0 = attachment
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.MaxTorque = math.huge
    alignOrientation.Responsiveness = 18
    alignOrientation.Parent = root

    createFlightEffects(character, root)
    local flightStartedAt = os.clock()

    flying = true
    status.Text = "●  飞行运行中"
    status.TextColor3 = Color3.fromRGB(116, 235, 178)
    toggle.Text = "关闭飞行"
    toggle.BackgroundColor3 = Color3.fromRGB(183, 70, 88)

    renderConnection = RunService.RenderStepped:Connect(function()
        if not flying or not root.Parent or not humanoid or not humanoid.Parent then
            stopFlight()
            return
        end

        updateFlightPose(os.clock() - flightStartedAt)
        protectFromFalling(root)

        local camera = workspace.CurrentCamera
        local cameraLook = camera.CFrame.LookVector
        local joystickDirection = humanoid.MoveDirection

        -- MoveDirection 来自 Roblox 默认摇杆 / 键盘，镜头俯仰角控制升降
        local horizontal = Vector3.new(joystickDirection.X, 0, joystickDirection.Z)
        local vertical = 0
        if horizontal.Magnitude > 0.01 then
            vertical = cameraLook.Y * horizontal.Magnitude
        end

        local movement = horizontal + Vector3.new(0, vertical, 0)
        if movement.Magnitude > 1 then movement = movement.Unit end
        linearVelocity.VectorVelocity = movement * speed

        if cameraLook.Magnitude > 0 then
            alignOrientation.CFrame = CFrame.lookAt(root.Position, root.Position + cameraLook)
        end
    end)
end

toggle.Activated:Connect(function()
    if flying then
        stopFlight()
    else
        startFlight()
    end
end)

player.CharacterAdded:Connect(function()
    stopFlight()
end)

gui.Destroying:Connect(function()
    stopFlight()
end)
