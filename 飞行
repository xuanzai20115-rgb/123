local function updateSlider(x)
    local width = math.max(slider.AbsoluteSize.X, 1)
    local ratio = math.clamp((x - slider.AbsolutePosition.X) / width, 0, 1)
    speed = math.floor(20 + ratio * 180 + 0.5)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, 0, 0.5, 0)
    speedLabel.Text = "速度  " .. speed
end

local sliding = false
sliderHitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = true
        updateSlider(input.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        updateSlider(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = false
        dragging = false
    end
end)

