function UI:Page(name, icon, desc)
    local navBtn=create("TextButton",nav,{Size=UDim2.new(1,0,0,39),BackgroundColor3=CONFIG.Panel,Text="",AutoButtonColor=false})
    corner(navBtn,9)
    local iconLabel=label(navBtn,icon or "◇",15,CONFIG.Muted,Enum.Font.GothamBold);iconLabel.Position=UDim2.fromOffset(12,0);iconLabel.Size=UDim2.fromOffset(22,39);iconLabel.TextXAlignment=Enum.TextXAlignment.Center
    local txt=label(navBtn,name,11,CONFIG.Muted,Enum.Font.GothamMedium);txt.Position=UDim2.fromOffset(43,0);txt.Size=UDim2.new(1,-50,1,0)
    local page=create("ScrollingFrame",pagesHolder,{Size=UDim2.fromScale(1,1),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,ScrollBarImageColor3=CONFIG.Accent,BackgroundTransparency=1,BorderSizePixel=0,Visible=false})
    pad(page,2,7,2,12)
    create("UIListLayout",page,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder})
    pages[name]=page;navButtons[name]={button=navBtn,icon=iconLabel,text=txt}
    navBtn.MouseButton1Click:Connect(function() UI:SelectPage(name) end)
    if not currentPage then UI:SelectPage(name) end
    return page
end
function UI:SelectPage(name)
    if not pages[name] then return end
    currentPage=name
    for n,p in pairs(pages) do
        if n == name then
            p.Visible = true
            p.Position = UDim2.new(0, 24, 0, 0)
            tween(p, {Position = UDim2.new(0, 0, 0, 0)}, .36, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        elseif p.Visible then
            tween(p, {Position = UDim2.new(0, -22, 0, 0)}, .20, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            local oldPage = p
            task.delay(.21, function()
                if oldPage.Parent and currentPage ~= n then
                    oldPage.Visible = false
                    oldPage.Position = UDim2.new(0, 0, 0, 0)
                end
            end)
        else
            p.Visible = false
            p.Position = UDim2.new(0, 0, 0, 0)
        end
    end
    for n,v in pairs(navButtons) do
        local active=n==name
        tween(v.button,{BackgroundColor3=active and Color3.fromRGB(47,39,70) or CONFIG.Panel},.18)
        tween(v.icon,{TextColor3=active and CONFIG.Accent or CONFIG.Muted},.18)
        tween(v.text,{TextColor3=active and CONFIG.Text or CONFIG.Muted},.18)
    end
    heading.Text=name
    description.Text=(name=="总览" and "管理面板与个性化设置") or "配置"..name.."相关设置与操作"
end
