local function create(class, parent, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end
local function corner(obj, radius)
    return create("UICorner", obj, {CornerRadius = UDim.new(0, radius or 10)})
end
local function stroke(obj, color, transparency, thickness)
    return create("UIStroke", obj, {Color = color or CONFIG.Surface2, Transparency = transparency or 0, Thickness = thickness or 1})
end
local function pad(obj, a, b, c, d)
    return create("UIPadding", obj, {PaddingLeft=UDim.new(0,a or 0), PaddingRight=UDim.new(0,b or 0), PaddingTop=UDim.new(0,c or 0), PaddingBottom=UDim.new(0,d or 0)})
end
local function tween(obj, props, duration, style, direction)
    local info = TweenInfo.new(duration or .22, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end
