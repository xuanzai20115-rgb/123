local function fit()
    camera=workspace.CurrentCamera
    if not camera then return end
    local v=camera.ViewportSize
    local availableX=math.max(280,v.X-20)
    local availableY=math.max(260,v.Y-40)
    local scale=math.min(1,availableX/CONFIG.Size.X,availableY/CONFIG.Size.Y)
    uiScale.Scale=scale;shadowScale.Scale=scale
