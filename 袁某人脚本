-- 实时测量渲染帧率；平台不直接提供设备屏幕硬件刷新率。
local frameCount,elapsed=0,0
local fps=60
keepConnection(RunService.RenderStepped:Connect(function(dt)
    frameCount=frameCount+1;elapsed=elapsed+dt
    if elapsed>=.5 then
        fps=math.floor(frameCount/elapsed+.5);frameCount=0;elapsed=0
        if fpsText and fpsText.Parent then fpsText.Text=tostring(fps).." 帧/秒" end
    end
end))

local function closeUI()
    if closed then return end;closed=true
    tween(main,{Size=UDim2.fromOffset(0,0),BackgroundTransparency=1},.25,Enum.EasingStyle.Back,Enum.EasingDirection.In)
    tween(shadow,{BackgroundTransparency=1},.2);tween(blur,{Size=0},.25)
    if island and island.Parent then tween(island,{Position=UDim2.new(island.Position.X.Scale,island.Position.X.Offset, island.Position.Y.Scale,-70),BackgroundTransparency=1},.22) end
    if fpsBadge and fpsBadge.Parent then tween(fpsBadge,{Position=UDim2.new(fpsBadge.Position.X.Scale,fpsBadge.Position.X.Offset,fpsBadge.Position.Y.Scale,-70),BackgroundTransparency=1},.22) end
    task.delay(.3,function()
        disconnectManaged()
        if gui and gui.Parent then gui:Destroy() end
        if blur and blur.Parent then blur:Destroy() end
        if cleanupHandle and cleanupHandle.Parent then cleanupHandle:Destroy() end
    end)
end
