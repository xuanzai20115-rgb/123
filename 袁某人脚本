local managedConnections = {}
local function keepConnection(connection)
    table.insert(managedConnections, connection)
    return connection
end
local function disconnectManaged()
    for _, connection in ipairs(managedConnections) do
        if connection and connection.Connected then connection:Disconnect() end
    end
    table.clear(managedConnections)
end
local cleanupHandle = Instance.new("BindableFunction")
cleanupHandle.Name = "袁某人脚本清理句柄"
cleanupHandle.OnInvoke = function()
    disconnectManaged()
    return true
end
