 -- 工具函数封装（独立模块，便于维护）
 local Utils = {
     -- 渐变文本生成（优化算法，提升性能）
     gradientText = function(text, startColor, endColor)
         if not text or #text == 0 then return "" end
         local result = ""
         local textLen = #text
         for i = 1, textLen do
             local t = textLen == 1 and 0 or (i - 1) / (textLen - 1)
             local r = math.floor(math.clamp(startColor.R + (endColor.R - startColor.R) * t, 0, 1) * 255)
             local g = math.floor(math.clamp(startColor.G + (endColor.G - startColor.G) * t, 0, 1) * 255)
             local b = math.floor(math.clamp(startColor.B + (endColor.B - startColor.B) * t, 0, 1) * 255)
             result = result .. string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, text:sub(i, i))
         end
         return result
     end,
     -- 远程脚本加载（统一容错，规范日志）
     loadRemoteScript = function(url, successMsg, failMsg)
         local success, err = pcall(function()
             local scriptCode = game:HttpGet(url)
             loadstring(scriptCode)()
         end)
         if success then
             WindUI:Notify({
                 Title = "执行成功",
                 Content = successMsg,
                 Duration = 2,
                 Color = CONFIG.SUCCESS_COLOR
             })
         else
             WindUI:Notify({
                 Title = "执行失败",
                 Content = failMsg,
                 Duration = 3,
                 Color = CONFIG.ERROR_COLOR
             })
             warn(string.format("[袁某人脚本] 加载失败：%s，错误详情：%s", url, err))
         end
     end
 }
